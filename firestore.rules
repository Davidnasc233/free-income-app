rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsResource() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnResource() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /transactions/{transactionId} {
      allow read, delete: if ownsResource();
      allow create: if createsOwnResource();
      allow update: if ownsResource() && createsOwnResource();
    }

    match /goals/{goalId} {
      allow read, delete: if ownsResource();
      allow create: if createsOwnResource();
      allow update: if ownsResource() && createsOwnResource();
    }
  }
}
